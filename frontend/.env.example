# TruthLens X Frontend Configuration (Vite + React)

# Mock Service Worker Toggle:
# Set to 'true' to run fully decoupled using MSW client fixtures
# Set to 'false' to communicate with live FastAPI backend on port 8000
VITE_USE_MOCKS=false

# Optional custom backend API endpoint (default proxy routes to http://127.0.0.1:8000)
# VITE_API_BASE_URL=http://127.0.0.1:8000
