# TruthLens X Backend Configuration
# 100% Offline, CPU-First Forensic Engine

# Ingestion Constraints
MAX_UPLOAD_MB=200
MAX_VIDEO_DURATION_SEC=300

# Speech-to-Text & CPU Models
WHISPER_MODEL=tiny.en
WHISPER_COMPUTE_TYPE=int8
ENABLE_OPTIONAL_MODELS=false
ENABLE_AI_ORIGIN_CLASSIFIER=true
AI_IMAGE_MODEL_ID=Organika/sdxl-detector

# Local Storage Paths & SQLite Database
DATA_DIR=./data
MODELS_DIR=./models
DB_NAME=truth_lens.db

# Server Networking
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=INFO

# Frontend / Mock Integration
VITE_USE_MOCKS=false
