# TruthLens X Environment Configuration

# Upload & Ingestion Constraints
MAX_UPLOAD_MB=200
MAX_VIDEO_DURATION_SEC=300

# Speech-to-Text & CPU Models
WHISPER_MODEL=tiny.en
WHISPER_COMPUTE_TYPE=int8
ENABLE_OPTIONAL_MODELS=false
ENABLE_AI_ORIGIN_CLASSIFIER=true
AI_IMAGE_MODEL_ID=Organika/sdxl-detector

# Storage Directories
DATA_DIR=./data
MODELS_DIR=./models

# Frontend / UI Configuration
VITE_USE_MOCKS=false
